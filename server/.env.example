# Скопируйте этот файл в server/.env и заполните значения:
#   cp .env.example .env

# Строка подключения к PostgreSQL (совпадает с docker-compose.yml: порт 5433)
DATABASE_URL="postgresql://cinema:cinema@localhost:5433/cinema?schema=public"

# Секрет подписи JWT — обязателен, без него сервер не запустится.
# Сгенерируйте надёжный секрет, например:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-long-random-secret"

# Порт API-сервера
PORT=4000

# Демо-режим: автофилл создаёт демо-заказы (isDemo) для автосгенерированных сеансов.
# Включён по умолчанию; 0/false/no/off — выключить (расписание заполняется всё равно).
DEMO_MODE=1

# Учётка администратора для первого сида (существующую не перезаписывает).
# ADMIN_LOGIN по умолчанию admin. ADMIN_PASSWORD по умолчанию admin123 — только в демо-режиме.
# При DEMO_MODE=0 пароль обязателен: без него сервер не запустится.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123